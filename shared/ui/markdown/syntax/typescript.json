    {
      "start": "'",
      "end": "'",
      "escape": "\\"
    },
    {
      "start": "`",
      "end": "`",
      "escape": "\\",
      "multiline": true
    }
  ],
  "functionPattern": "\\b([A-Za-z_$][A-Za-z0-9_$]*)\\s*(?=\\()"
}
